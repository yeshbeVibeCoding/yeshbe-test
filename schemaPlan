{
  "appType": "app",
  "category": "saas",
  "title": "Ticket Manager",
  "description": "A ticket management app where users can register, login, submit tickets, and track their status.",
  "slug": "ticket-manager",
  "lang": ["en"],
  "color": "ocean",
  "fontFamily": "Inter",
  "headingFamily": "",
  "fontLink": "https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap",
  "pages": [
    {
      "name": "Dashboard",
      "info": "Main dashboard showing ticket overview and stats for logged-in users",
      "route": "/",
      "lang": "en",
      "home": true,
      "auth": true,
      "type": "page"
    },
    {
      "name": "MyTickets",
      "info": "List of all tickets submitted by the logged-in user with status filters",
      "route": "/my-tickets",
      "lang": "en",
      "home": false,
      "auth": true,
      "type": "page"
    },
    {
      "name": "SubmitTicket",
      "info": "Form page for users to submit a new support ticket",
      "route": "/submit-ticket",
      "lang": "en",
      "home": false,
      "auth": true,
      "type": "page"
    },
    {
      "name": "TicketDetail",
      "info": "Detail view of a single ticket showing full info, status history, and comments",
      "route": "/tickets/:id",
      "lang": "en",
      "home": false,
      "auth": true,
      "type": "page"
    },
    {
      "name": "AdminTickets",
      "info": "Admin view to manage all tickets, update statuses, and assign tickets",
      "route": "/admin/tickets",
      "lang": "en",
      "home": false,
      "auth": true,
      "type": "page"
    },
    {
      "name": "Login",
      "info": "Login page for existing users",
      "route": "/login",
      "lang": "en",
      "home": false,
      "auth": false,
      "type": "login"
    },
    {
      "name": "Register",
      "info": "Registration page for new users to create an account",
      "route": "/register",
      "lang": "en",
      "home": false,
      "auth": false,
      "type": "register"
    }
  ],
  "entities": [
    {
      "name": "User",
      "system": true,
      "type": "object",
      "properties": {
        "department": {
          "type": "string",
          "maxLength": 100,
          "description": "Department the user belongs to",
          "default": null
        }
      },
      "required": []
    },
    {
      "name": "Ticket",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 100,
          "description": "Short title of the ticket",
          "default": null
        },
        "description": {
          "type": "text",
          "description": "Full description of the issue or request",
          "default": null
        },
        "status": {
          "type": "enum",
          "values": ["open", "in_progress", "resolved", "closed"],
          "labels": {
            "open": "Open",
            "in_progress": "In Progress",
            "resolved": "Resolved",
            "closed": "Closed"
          },
          "description": "Current status of the ticket",
          "default": "open"
        },
        "priority": {
          "type": "enum",
          "values": ["low", "medium", "high", "urgent"],
          "labels": {
            "low": "Low",
            "medium": "Medium",
            "high": "High",
            "urgent": "Urgent"
          },
          "description": "Priority level of the ticket",
          "default": "medium"
        },
        "category": {
          "type": "enum",
          "values": ["technical", "billing", "general", "feature_request"],
          "labels": {
            "technical": "Technical",
            "billing": "Billing",
            "general": "General",
            "feature_request": "Feature Request"
          },
          "description": "Category of the ticket",
          "default": "general"
        }
      },
      "required": ["title", "description"],
      "publicRead": false,
      "publicCreate": false
    },
    {
      "name": "TicketComment",
      "type": "object",
      "properties": {
        "ticketId": {
          "type": "relation",
          "ref": "Ticket",
          "parent": true,
          "description": "The ticket this comment belongs to"
        },
        "message": {
          "type": "text",
          "description": "Content of the comment",
          "default": null
        }
      },
      "required": ["ticketId", "message"],
      "publicRead": false,
      "publicCreate": false
    }
  ],
  "auth": {
    "enabled": true,
    "type": "mixed",
    "hasUserRoles": true,
    "roles": [
      { "id": 1, "label": "User" },
      { "id": 2, "label": "Support Agent" },
      { "id": 3, "label": "Admin" }
    ]
  },
  "payments": {
    "enabled": false,
    "mode": "checkout"
  }
}