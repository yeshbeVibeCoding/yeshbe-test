@import url('https://fonts.googleapis.com/css2?family=Assistant:wght@300;400;500;600;700;800;900&display=swap');

:root {
  --primary: #D97706;
  --primary-hover: #B45309;
  --primary-light: #FEF3C7;
  --primary-text: #ffffff;

  --secondary: #FEF9E9;
  --secondary-hover: #FDF0CE;
  --secondary-light: #FFFDF5;
  --secondary-text: #D97706;

  --accent: #4F46E5;
  --accent-hover: #4338CA;
  --accent-light: #E0E7FF;
  --accent-text: #ffffff;

  --success: #22C55E;
  --success-hover: #16A34A;
  --success-light: #DCFCE7;
  --success-text: #15803D;

  --error: #EF4444;
  --error-hover: #DC2626;
  --error-light: #FEE2E2;
  --error-text: #B91C1C;

  --warning: #F59E0B;
  --warning-hover: #D97706;
  --warning-light: #FEF3C7;
  --warning-text: #B45309;

  --info: #3B82F6;
  --info-hover: #2563EB;
  --info-light: #DBEAFE;
  --info-text: #1D4ED8;

  --background: #FFFDF5;
  --surface: #ffffff;
  --surface-2: #FEF9E9;
  --surface-3: #FDF0CE;
  --overlay: rgba(0,0,0,0.45);

  --text: #3A2708;
  --text-secondary: #6B5127;
  --text-muted: #B3A181;
  --text-inverse: #ffffff;
  --text-link: #D97706;
  --text-link-hover: #B45309;

  --border: #FDF0CE;
  --border-focus: #D97706;
  --border-error: #EF4444;
  --border-success: #22C55E;
  --divider: #FEF9E9;

  --btn-primary-bg: #D97706;
  --btn-primary-hover: #B45309;
  --btn-primary-text: #ffffff;
  --btn-secondary-bg: #FEF9E9;
  --btn-secondary-hover: #FDF0CE;
  --btn-secondary-text: #D97706;
  --btn-secondary-border: #D97706;
  --btn-danger-bg: #EF4444;
  --btn-danger-hover: #DC2626;
  --btn-danger-text: #ffffff;
  --btn-danger-border: #EF4444;
  --btn-ghost-hover: #FEF3C7;
  --btn-ghost-text: #D97706;
  --btn-radius: 10px;
  --btn-sm-padding: 6px 14px;
  --btn-md-padding: 10px 22px;
  --btn-lg-padding: 14px 32px;
  --btn-font-weight: 600;

  --input-bg: #ffffff;
  --input-bg-focus: #FFFDF5;
  --input-border: #FDF0CE;
  --input-focus: #D97706;
  --input-error: #EF4444;
  --input-success: #22C55E;
  --input-text: #3A2708;
  --input-placeholder: #B3A181;
  --input-radius: 10px;
  --input-padding: 10px 14px;
  --input-font-size: 15px;

  --card-bg: #ffffff;
  --card-border: #FEF9E9;
  --card-radius: 14px;
  --card-padding: 24px;
  --card-shadow: 0 2px 12px rgba(217,119,6,0.07);
  --card-hover-shadow: 0 6px 24px rgba(217,119,6,0.15);

  --table-header-bg: #FEF3C7;
  --table-header-text: #D97706;
  --table-row-hover: #FFFDF5;
  --table-border: #FEF9E9;
  --table-row-even: #FFFDF5;
  --table-row-odd: #ffffff;

  --badge-radius: 999px;
  --badge-padding: 3px 10px;
  --badge-font-size: 12px;
  --badge-font-weight: 600;

  --modal-bg: #ffffff;
  --modal-radius: 18px;
  --modal-padding: 32px;
  --modal-shadow: 0 8px 40px rgba(217,119,6,0.18);

  --menu-bg: #ffffff;
  --menu-border: #FEF9E9;
  --menu-radius: 12px;
  --menu-shadow: 0 4px 20px rgba(217,119,6,0.12);
  --menu-item-hover: #FEF9E9;
  --menu-item-text: #3A2708;
  --menu-item-padding: 10px 16px;

  --tab-active-bg: #D97706;
  --tab-active-text: #ffffff;
  --tab-inactive: #B3A181;
  --tab-hover-text: #D97706;
  --tab-radius: 8px;
  --tab-padding: 8px 18px;

  --sidebar-bg: #3A2708;
  --sidebar-text: #E0CFAE;
  --sidebar-text-active: #ffffff;
  --sidebar-item-active: #D97706;
  --sidebar-item-hover: rgba(217,119,6,0.15);
  --sidebar-border: rgba(255,255,255,0.07);
  --sidebar-w: 240px;
  --sidebar-w-sm: 64px;

  --header-bg: #ffffff;
  --header-border: #FEF9E9;
  --header-h: 64px;
  --header-text: #3A2708;

  --radius-xs: 4px;
  --radius-sm: 6px;
  --radius: 8px;
  --radius-md: 10px;
  --radius-lg: 14px;
  --radius-xl: 18px;
  --radius-2xl: 24px;
  --radius-full: 9999px;

  --shadow-xs: 0 1px 3px rgba(217,119,6,0.06);
  --shadow-sm: 0 2px 8px rgba(217,119,6,0.08);
  --shadow-md: 0 4px 16px rgba(217,119,6,0.10);
  --shadow-lg: 0 8px 32px rgba(217,119,6,0.13);
  --shadow-xl: 0 16px 48px rgba(217,119,6,0.18);

  --font: 'Assistant', sans-serif;
  --font-heading: 'Assistant', sans-serif;
  --font-mono: 'Courier New', monospace;
  --font-size-xs: 11px;
  --font-size-sm: 13px;
  --font-size-base: 15px;
  --font-size-md: 16px;
  --font-size-lg: 18px;
  --font-size-xl: 21px;
  --font-size-2xl: 26px;
  --font-size-3xl: 32px;
  --font-size-4xl: 42px;

  --font-weight-normal: 400;
  --font-weight-medium: 500;
  --font-weight-semibold: 600;
  --font-weight-bold: 700;
  --font-weight-black: 900;

  --line-height-tight: 1.2;
  --line-height-normal: 1.5;
  --line-height-relaxed: 1.75;

  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 20px;
  --space-6: 24px;
  --space-7: 28px;
  --space-8: 32px;
  --space-10: 40px;
  --space-12: 48px;
  --space-16: 64px;

  --content-max-w: 1100px;
  --content-padding: 24px;
  --transition: 0.18s ease;
  --transition-slow: 0.35s ease;
}

.dark {
  --background: #1C1304;
  --surface: #2A1D09;
  --surface-2: #39280F;
  --surface-3: #4C3717;
  --overlay: rgba(0,0,0,0.65);
  --text: #FBF0D5;
  --text-secondary: #C9B58A;
  --text-muted: #8E8060;
  --text-inverse: #2A1D09;
  --text-link: #FBBF24;
  --text-link-hover: #FBBF24;
  --border: #4C3717;
  --border-focus: #FBBF24;
  --divider: #39280F;
  --card-bg: #2A1D09;
  --card-border: #4C3717;
  --header-bg: #2A1D09;
  --header-border: #4C3717;
  --input-bg: #39280F;
  --input-bg-focus: #4C3717;
  --input-border: #4C3717;
  --input-text: #FBF0D5;
  --table-header-bg: #39280F;
  --table-row-even: #2A1D09;
  --table-row-odd: #39280F;
  --table-row-hover: #4C3717;
  --modal-bg: #2A1D09;
  --menu-bg: #2A1D09;
  --menu-border: #4C3717;
  --menu-item-hover: #39280F;
  --menu-item-text: #FBF0D5;
  --tab-inactive: #8E8060;
  --primary-light: #39280F;
  --secondary: #39280F;
  --secondary-hover: #4C3717;
  --secondary-light: #2A1D09;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: var(--font);
  background: var(--background);
  color: var(--text);
  font-size: var(--font-size-base);
  line-height: var(--line-height-normal);
}
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--border); border-radius: var(--radius-full); }
::selection { background: var(--primary-light); color: var(--primary); }
:focus-visible { outline: 2px solid var(--border-focus); outline-offset: 2px; }
