[
  {
    "name": "User",
    "system": true,
    "type": "object",
    "properties": {
      "department": {
        "type": "string",
        "maxLength": 100,
        "description": "Department the user belongs to",
        "default": null
      }
    },
    "required": []
  },
  {
    "name": "Ticket",
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "maxLength": 100,
        "description": "Short title of the ticket",
        "default": null
      },
      "description": {
        "type": "text",
        "description": "Full description of the issue or request",
        "default": null
      },
      "status": {
        "type": "enum",
        "values": [
          "open",
          "in_progress",
          "resolved",
          "closed"
        ],
        "labels": {
          "open": "Open",
          "in_progress": "In Progress",
          "resolved": "Resolved",
          "closed": "Closed"
        },
        "description": "Current status of the ticket",
        "default": "open"
      },
      "priority": {
        "type": "enum",
        "values": [
          "low",
          "medium",
          "high",
          "urgent"
        ],
        "labels": {
          "low": "Low",
          "medium": "Medium",
          "high": "High",
          "urgent": "Urgent"
        },
        "description": "Priority level of the ticket",
        "default": "medium"
      },
      "category": {
        "type": "enum",
        "values": [
          "technical",
          "billing",
          "general",
          "feature_request"
        ],
        "labels": {
          "technical": "Technical",
          "billing": "Billing",
          "general": "General",
          "feature_request": "Feature Request"
        },
        "description": "Category of the ticket",
        "default": "general"
      }
    },
    "required": [
      "title",
      "description"
    ],
    "publicRead": false,
    "publicCreate": false
  },
  {
    "name": "TicketComment",
    "type": "object",
    "properties": {
      "ticketId": {
        "type": "relation",
        "ref": "Ticket",
        "parent": true,
        "description": "The ticket this comment belongs to"
      },
      "message": {
        "type": "text",
        "description": "Content of the comment",
        "default": null
      }
    },
    "required": [
      "ticketId",
      "message"
    ],
    "publicRead": false,
    "publicCreate": false
  }
]